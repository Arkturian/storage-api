# Storage API Configuration

# Database
DATABASE_URL=sqlite:///./storage.db
# DATABASE_URL=postgresql://user:password@localhost/storage

# API Keys
API_KEY=<setzen>

# AI Services
GEMINI_API_KEY=<setzen>
OPENAI_API_KEY=<setzen>

# Storage Paths
STORAGE_BASE_PATH=/var/www/storage
THUMBNAILS_DIR=/var/www/storage/thumbnails
WEBVIEW_DIR=/var/www/storage/webview

# Vector Database
CHROMA_DB_PATH=./chroma_db

# Tenant Configuration
TENANT_CONFIG_PATH=./tenant_config.json

# Server
HOST=0.0.0.0
PORT=8002

# Processing
MAX_UPLOAD_SIZE_MB=100
IMAGE_QUALITY_DEFAULT=85

# AI Microservice
AI_API_URL=https://api-ai.arkturian.com
INTERNAL_API_KEY=<setzen>

# Public path prefix when a reverse proxy mounts storage-api under a path
# (customer instances: /svc/storage). Added to every absolute link the API
# builds (signed media URLs, file_url, upload tickets, share links). Taken only
# from this setting, never from a request header. Not added for loopback
# hosts (127.0.0.0/8, ::1, localhost): those callers reach uvicorn directly.
# Leave empty on the core.
# STORAGE_URL_PREFIX=/svc/storage
